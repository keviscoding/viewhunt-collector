# Copy values into DigitalOcean App Platform env + Fly secrets as needed.
# See DEPLOY-FLY.md for full instructions.

WORKER_SECRET=
APP_URL=https://viewhunt.app
# DO default ingress — Fly workers should call this (avoids Cloudflare hangs)
APP_INTERNAL_URL=https://your-app.ondigitalocean.app

FLY_API_TOKEN=
FLY_ASSEMBLY_APP=viewhunt-assembly
FLY_SCRAPER_APP=viewhunt-scraper
FLY_ASSEMBLY_IMAGE=registry.fly.io/viewhunt-assembly:latest
FLY_SCRAPER_IMAGE=registry.fly.io/viewhunt-scraper:latest

# Durable video storage — DigitalOcean Spaces (ViewHunt bucket ONLY)
# Do NOT point these at channelrecipe-media or other business buckets.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=viewhunt-media
SPACES_REGION=sfo3
# API endpoint (region host) — NOT the bucket URL
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
# Optional public base (defaults to https://viewhunt-media.sfo3.digitaloceanspaces.com)
# SPACES_CDN_URL=https://viewhunt-media.sfo3.digitaloceanspaces.com

YOUTUBE_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=ViewHunt <noreply@viewhunt.app>
SCRAPE_NOTIFY_EMAIL=nwalikelv@gmail.com
ADMIN_EMAIL=nwalikelv@gmail.com
GEMINI_API_KEY=
APIFY_TOKEN=
# Optional: word-level caption sync via Whisper + OpenAI TTS fallback if Gemini TTS fails
OPENAI_API_KEY=
# Burned-in caption removal (Replicate) — official env name is REPLICATE_API_TOKEN
REPLICATE_API_TOKEN=
# REPLICATE_API_KEY=  (alias also accepted)
